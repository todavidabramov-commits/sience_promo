# Payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Postgres (local docker / Neon / Vercel Postgres)
# Local: postgresql://postgres:postgres@127.0.0.1:5432/sience_promo
# Vercel+Neon: set automatically as POSTGRES_URL after connecting Neon
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/sience_promo

# Vercel Blob (production uploads). Leave empty for local disk storage.
BLOB_READ_WRITE_TOKEN=

# Public site URL (SEO / canonical)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Yandex Maps JS API (contacts page). Optional: map still tries to load without a key.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
